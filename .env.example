# ---------------------------------------------------------------------------
# Autonomous Research Lab — environment template
# Copy to `.env` (git-ignored) and fill in what you need.
# Nothing here is required to run the app: the Lab Simulator provider is
# keyless and exercises the whole engine, including rate-limit handing.
# ---------------------------------------------------------------------------

# --- Vault -----------------------------------------------------------------
# Master secret used to derive the AES-256-GCM key that protects session API
# keys at rest. If unset, one is generated at data/master.key with mode 0600.
# Set this explicitly in any real deployment. Minimum 16 characters.
# LAB_SESSION_SECRET=change-me-to-a-long-random-string

# --- Storage ---------------------------------------------------------------
# SQLite file for rooms, agents, log entries and the durable job queue.
# LAB_DATABASE_PATH=./data/lab.db

# --- Runtime ---------------------------------------------------------------
# inline   = in-process scheduler ticks the queue (long-lived Node server).
# external = nothing runs on its own; a cron calls POST /api/tick.
# LAB_RUNTIME=inline
# Max cycles executing at once across all rooms.
# LAB_MAX_CONCURRENCY=4

# --- Provider credentials (optional) ---------------------------------------
# A per-session key overrides these; these cover keyless/shared deployments.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=

# --- Simulator tuning -------------------------------------------------------
# Inject a 429 every N cycles per agent (0 disables). Default 3.
# LAB_SIM_RATE_LIMIT_EVERY=3
# Force every simulated call to throttle (useful for manual testing).
# LAB_SIM_FORCE_RATE_LIMIT=0
# Defaults for rooms seeded from /api/demo.
# LAB_DEMO_ITERATIONS=14
# LAB_DEMO_CYCLE_MS=7000

# --- Optional: Redis / Upstash driver ---------------------------------------
# The queue ships with a durable SQLite driver. To move job state to Redis,
# set these and implement the driver described in the README ("Scaling out").
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
